{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "r2_buckets": [
    { "binding": "BRAIN", "bucket_name": "agent-brain" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SCHEDULER", "class_name": "Scheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Scheduler"] }
  ],
  "vars": {
    "GITHUB_BRANCH": "main",
    "NOTIFY_FORMAT": "gchat",
    "NOTIFY_LEVEL": "urgent",
    "STORAGE_CEILING_GB": "8",
    "MAX_FILE_MB": "25",
    "CF_ACCOUNT_ID": "80eed4e66f7c4ebc41e8a7bc92f79f8b",
    "ACCESS_TEAM_DOMAIN": "atllc-ai-brain.cloudflareaccess.com",
    "ACCESS_AUD": "9b644a072e470f5965950c1a16e021fd59d44e48a6e4e79325613aa39a110fbd",
    "OWNER_EMAIL": "luke@adamtraywick.com",
    "TRELLO_CALLBACK_URL": "https://brain.atllc-ai-brain.workers.dev/hooks/trello",
    "TRELLO_WRITE_BOARDS": "PM Build",
    "TRAINWEL_RESTRICTED_ARTICLES": "13155",
    "TRAINWEL_REVIEWED_ARTICLES": "",
    "DAILY_CALL_LIMIT": "3000",
    "DAILY_WRITE_LIMIT": "500",
    "OWNER_ACTOR": "human:luke",
    "INSTANCE_NAME": "ATLLC Brain",
    "OWNER_TIMEZONE": "America/Chicago"
  },
  "observability": { "enabled": true },
  // Staging (PLAN.md 0.18): the same code with its own bucket, KV namespace, scheduler, tokens and owner password. Deploy with
  // `npm run deploy:staging`. Nothing is inherited from the top level except the code, so every binding and variable is listed.
  "env": {
    "staging": {
      "name": "brain-staging",
      "r2_buckets": [
        { "binding": "BRAIN", "bucket_name": "agent-brain-staging" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SCHEDULER", "class_name": "Scheduler" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Scheduler"] }
      ],
      "vars": {
        "GITHUB_BRANCH": "main",
        "NOTIFY_FORMAT": "gchat",
        "NOTIFY_LEVEL": "all",
        "STORAGE_CEILING_GB": "8",
        "MAX_FILE_MB": "25",
        "CF_ACCOUNT_ID": "80eed4e66f7c4ebc41e8a7bc92f79f8b",
        "ACCESS_TEAM_DOMAIN": "atllc-ai-brain.cloudflareaccess.com",
        "ACCESS_AUD": "c51d43a157777cb537beae8da6e3609611f5db6b927c10ea9e30c97179b0c39f",
        "OWNER_EMAIL": "luke@adamtraywick.com",
        "TRELLO_CALLBACK_URL": "https://brain-staging.atllc-ai-brain.workers.dev/hooks/trello",
        "TRELLO_WRITE_BOARDS": "PM Build",
        "TRAINWEL_RESTRICTED_ARTICLES": "13155",
        "TRAINWEL_REVIEWED_ARTICLES": "",
        "DAILY_CALL_LIMIT": "3000",
        "DAILY_WRITE_LIMIT": "500",
        "OWNER_ACTOR": "human:luke",
        "INSTANCE_NAME": "ATLLC Brain (staging)",
        "OWNER_TIMEZONE": "America/Chicago"
      },
      "observability": { "enabled": true }
    }
  }
}
