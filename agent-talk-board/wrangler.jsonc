{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-talk-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "r2_buckets": [
    { "binding": "BRAIN", "bucket_name": "agent-brain" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SCHEDULER", "class_name": "Scheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Scheduler"] }
  ],
  "vars": {
    "GITHUB_BRANCH": "main",
    "NOTIFY_FORMAT": "gchat",
    "NOTIFY_LEVEL": "urgent",
    "STORAGE_CEILING_GB": "8",
    "CF_ACCOUNT_ID": "80eed4e66f7c4ebc41e8a7bc92f79f8b",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "DAILY_CALL_LIMIT": "3000",
    "DAILY_WRITE_LIMIT": "500",
    "OWNER_ACTOR": "human:luke",
    "INSTANCE_NAME": "ATLLC Brain",
    "OWNER_TIMEZONE": "America/Chicago"
  },
  "observability": { "enabled": true }
}
